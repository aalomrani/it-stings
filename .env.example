# It Stings — environment
#
# Copy to `.env.local` (git-ignored) and fill in what you have. EVERY var is optional:
# a missing key degrades one feature, it never crashes the app. `GET /api/health`
# reports which keys are present. Nothing in this file is ever shipped to the browser —
# `src/lib/env.ts` is server-only and no route returns a key value.

# The recommendation engine (@anthropic-ai/sdk).
# Missing -> recommendations unavailable; search / resolve / preview / playlists keep working.
# Signup: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model id override. Missing -> claude-opus-5 (docs/model.md). Never append a date suffix.
ITSTINGS_MODEL=claude-opus-5

# Server-side refusal fallbacks (docs/model.md). "1"/"true"/"on" enables, "0"/"false"/"off"
# disables. Missing -> on.
ITSTINGS_FALLBACKS=1

# Last.fm: Channel A (track.getSimilar, tag.getTopTracks) and the seed's crowd tags.
# Missing -> Channel A skipped; the fingerprint loses tags.
# Signup: https://www.last.fm/api/account/create  (302 -> login; create a user at
# https://www.last.fm/join first)
LASTFM_API_KEY=

# Channel B web search — Tavily is primary.
# Missing (and no Brave key) -> Channel B skipped.
# Signup: https://app.tavily.com
TAVILY_API_KEY=

# Channel B web search — Brave is the fallback used only when TAVILY_API_KEY is absent.
# Brave's ToS forbids storing results, so Brave responses are never cached.
# Signup: https://api-dashboard.search.brave.com/app/plans  (card required even on free)
BRAVE_SEARCH_API_KEY=

# Spotify. Two separate features share the client id:
#  - "push to spotify" (PKCE) needs ONLY SPOTIFY_CLIENT_ID + SPOTIFY_REDIRECT_URI.
#  - resolved deep links to the exact track need id AND secret (client-credentials search).
# Missing -> links.spotify falls back to https://open.spotify.com/search/<artist title>.
# Development Mode (2026): app owner needs Premium, 5 authorised users max.
# Signup: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Spotify redirect URI (Phase 6 OAuth). Must be a loopback IP literal — Spotify rejects
# "localhost". Missing -> defaults to http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# GetSongBPM tempo fallback (host is api.getsong.co, NOT api.getsongbpm.com).
# Using a key obliges us to render the "Tempo data by GetSongBPM" backlink.
# Missing -> tempo falls through to AcousticBrainz, or stays unknown.
# Signup: https://getsongbpm.com/api  (browser only — Cloudflare blocks curl)
GETSONGBPM_API_KEY=

# Optional: override the SQLite file location. ":memory:" is allowed (tests use it).
# Missing -> data/itstings.sqlite
# ITSTINGS_DB_PATH=data/itstings.sqlite

# ---------------------------------------------------------------------------
# Shared deployment (docs/deploy.md). All three are OFF when unset, which is the
# local single-user default — nothing below changes how the app runs on your machine.
# ---------------------------------------------------------------------------

# Invite gate. Set it and every request without the `itstings` cookie is redirected to
# /gate (API routes answer 401 JSON instead); /api/health is always reachable so the
# healthcheck works. Share the app with the link
#     https://<your-app>/?key=<the same value>
# which sets an httpOnly cookie for 180 days and strips the key from the URL.
# Missing -> no gate, exactly like a local run. Generate one with:
#     node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
ITSTINGS_ACCESS_TOKEN=

# Cost caps for a shared instance. Counted in SQLite (`run_counters`), so they survive a
# restart or a machine that auto-stopped. A run served from the cache costs nothing and
# is not counted. Missing -> unlimited (local). "0" -> unlimited, explicitly.
# The deployed image sets 60 and 6 (see Dockerfile / fly.toml).
# ITSTINGS_MAX_RUNS_PER_DAY=60
# ITSTINGS_MAX_RUNS_PER_IP_PER_HOUR=6
